-- =====================================================
-- Logic modification
-- =====================================================

-- Cache modul yang sudah dimodifikasi (per-tool, reset saat respawn)
local modifiedCache = setmetatable({}, {__mode = "k"})

local function safeRequire(moduleScript)
    if not moduleScript or not moduleScript:IsA("ModuleScript") then return nil end
    local ok, result = pcall(function() return require(moduleScript) end)
    if ok and type(result) == "table" then return result end
    return nil
end

local function modifyModule(mod, callback)
    if type(mod) ~= "table" then return end
    for k, v in pairs(mod) do
        local ok = pcall(function() callback(k, v) end)
        if not ok then
            -- skip property yang read-only
        end
    end
end

local function applyMacro(tool)
    if not tool or not tool:IsA("Tool") then return end
    local s = tool:FindFirstChild("Setting")
    if not s or not s:IsA("ModuleScript") then return end

    local m = safeRequire(s)
    if not m then return end

    modifyModule(m, function(k, v)
        if type(k) ~= "string" then return end
        local kLower = string.lower(k)
        local vType = type(v)

        if vType == "number" then
            if kLower:find("firerate") or kLower:find("firedelay")
               or kLower:find("rateoffire") or kLower:find("cooldown")
               or kLower:find("shootdelay") or kLower:find("interval") then
                pcall(function() m[k] = 0.15 end)
            elseif kLower:find("recoil") or kLower:find("kick")
               or kLower:find("shake") or kLower:find("bloom") then
                pcall(function() m[k] = 0 end)
            elseif kLower:find("spread") or kLower:find("inaccuracy") then
                pcall(function() m[k] = 0 end)
            elseif kLower == "accuracy" then
                pcall(function() m[k] = 1 end)
            end
        elseif vType == "boolean" then
            if kLower:find("auto") or kLower:find("automatic")
               or kLower:find("fullauto") then
                pcall(function() m[k] = true end)
            end
        end
    end)

    modifiedCache[tool] = true
end

local function applyNoRecoil(tool)
    if not tool or not tool:IsA("Tool") then return end
    local s = tool:FindFirstChild("Setting")
    if not s then return end
    local m = safeRequire(s)
    if not m then return end

    modifyModule(m, function(k, v)
        if type(k) ~= "string" or type(v) ~= "number" then return end
        local kl = string.lower(k)
        if kl:find("recoil") or kl:find("kick")
           or kl:find("shake") or kl:find("bloom") then
            pcall(function() m[k] = 0 end)
        end
    end)
end

local function applyNoSpread(tool)
    if not tool or not tool:IsA("Tool") then return end
    local s = tool:FindFirstChild("Setting")
    if not s then return end
    local m = safeRequire(s)
    if not m then return end

    modifyModule(m, function(k, v)
        if type(k) ~= "string" or type(v) ~= "number" then return end
        local kl = string.lower(k)
        if kl:find("spread") or kl:find("inaccuracy") then
            pcall(function() m[k] = 0 end)
        elseif kl == "accuracy" then
            pcall(function() m[k] = 1 end)
        end
    end)
end

local function applyToContainer(container)
    if not container then return end
    for _, c in ipairs(container:GetChildren()) do
        if c:IsA("Tool") then
            safeCall(function()
                if _G.KIZ.NoRecoil then applyNoRecoil(c) end
                if _G.KIZ.NoSpread then applyNoSpread(c) end
                if _G.KIZ.ForceAuto and not modifiedCache[c] then
                    applyMacro(c)
                end
            end)
        end
    end
end

local function applyToAll()
    local char = LocalPlayer.Character
    if char then applyToContainer(char) end
    local bp = LocalPlayer:FindFirstChildOfClass("Backpack")
    if bp then applyToContainer(bp) end
end

