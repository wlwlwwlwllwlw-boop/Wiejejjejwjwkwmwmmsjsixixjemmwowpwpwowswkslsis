-- == State error guard ==
local errorCount = 0
local MAX_ERRORS = 25
local locked = false

local function safeCall(fn, ...)
    if locked then return end
    local ok, err = pcall(fn, ...)
    if not ok then
        errorCount = errorCount + 1
        if errorCount >= MAX_ERRORS then
            locked = true
            warn("[KIZ] Terlalu banyak error, macro dimatikan otomatis.")
        end
    else
        -- reset bertahap agar tidak salah mati
        if errorCount > 0 then errorCount = errorCount - 1 end
    end
end

