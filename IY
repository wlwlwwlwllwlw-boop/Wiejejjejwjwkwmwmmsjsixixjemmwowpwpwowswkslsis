-- =====================================================
-- LOOP MACRO (pakai RunService, anti-throttle)
-- =====================================================
local autoFireCooldown = 0

RunService.Heartbeat:Connect(function(dt)
    if locked then return end
    if not ScreenGui.Parent then return end

    if _G.KIZ.ForceAuto then
        autoFireCooldown = autoFireCooldown - dt
        if autoFireCooldown <= 0 then
            autoFireCooldown = _G.KIZ.Speed
            local char = LocalPlayer.Character
            if char then
                local tool = char:FindFirstChildOfClass("Tool")
                if tool and tool:FindFirstChild("Setting") then
                    safeCall(applyMacro, tool)
                    -- Cek apakah tool masih ada & di-equip sebelum activate
                    if tool.Parent == char then
                        pcall(function() tool:Activate() end)
                    end
                end
            end
        end
    end
end)

-- Loop refresh NoRecoil/NoSpread (lebih jarang, 1 detik)
task.spawn(function()
    while ScreenGui.Parent and not locked do
        if _G.KIZ.NoRecoil or _G.KIZ.NoSpread then
            safeCall(applyToAll)
        end
        task.wait(1)
    end
end)

-- =====================================================
-- WATCHER: karakter & tool baru
-- =====================================================
local function watchChar(char)
    if not char then return end

    local conn
    conn = char.ChildAdded:Connect(function(child)
        if not child:IsA("Tool") then return end
        task.wait(0.3)
        if not child.Parent then return end
        safeCall(function()
            if _G.KIZ.NoRecoil then applyNoRecoil(child) end
            if _G.KIZ.NoSpread then applyNoSpread(child) end
            if _G.KIZ.ForceAuto then applyMacro(child) end
        end)
    end)

    -- Auto disconnect jika char hilang
    char.AncestryChanged:Connect(function(_, parent)
        if not parent and conn then
            conn:Disconnect()
        end
    end)
end

if LocalPlayer.Character then watchChar(LocalPlayer.Character) end
LocalPlayer.CharacterAdded:Connect(function(char)
    task.wait(2)
    -- Reset cache saat respawn
    modifiedCache = setmetatable({}, {__mode = "k"})
    if char.Parent then watchChar(char) end
end)

-- =====================================================
-- DRAGGABLE (with cleanup)
-- =====================================================
local dragging = false
local dragInput, dragStart, startPos

MainFrame.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
       or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = MainFrame.Position
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
            end
        end)
    end
end)

MainFrame.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement
       or input.UserInputType == Enum.UserInputType.Touch then
        dragInput = input
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if input == dragInput and dragging then
        local delta = input.Position - dragStart
        MainFrame.Position = UDim2.new(
            startPos.X.Scale, startPos.X.Offset + delta.X,
            startPos.Y.Scale, startPos.Y.Offset + delta.Y
        )
    end
end)

